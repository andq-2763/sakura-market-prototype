# Supabase プロジェクトの値を設定して .env.local として保存する（.env.local はコミットしない）
# Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # anon（または publishable）キー
SUPABASE_SERVICE_ROLE_KEY=               # service_role（または secret）キー。サーバ専用・公開禁止
# Connect → Session pooler の接続文字列（npm run db:setup でのみ使用。Vercel には不要）
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# デモアカウント共通パスワード（省略時 Sakura#2026）
DEMO_PASSWORD=
